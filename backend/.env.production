# ── Production Environment ────────────────────────────────────────────────────
# Copy this file to .env on the production server (5.189.144.200)
# or set these as system environment variables.

ENV=production

# ── Paths ─────────────────────────────────────────────────────────────────────
# flows/ now lives inside backend/ — no need to set this unless overriding
# DISK_FLOWS_DIR=/custom/path/to/flows

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://5.189.144.200:3000,http://5.189.144.200:3001,http://5.189.144.200

# ── Platform Settings ─────────────────────────────────────────────────────────
SCREENSHOT_MODE=named_only
SKIP_LLM=false
LLM_MODEL=qwen3-vl:32b
VISION_MODEL=qwen3-vl:32b
LLM_TIMEOUT=60
BULK_MAX_PARALLEL=3

# ── LLM ───────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── Browser ───────────────────────────────────────────────────────────────────
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=0
BROWSER_NAVIGATION_TIMEOUT=180000

# ── App Login ─────────────────────────────────────────────────────────────────
