# ──────────────────────────────────────────────────────────────────────────────
# QA Automation Platform — Environment Configuration
# Copy to .env and fill in your values before starting the backend.
# ──────────────────────────────────────────────────────────────────────────────

# Platform security (admin login — NOT flow credentials)
SECRET_KEY=change-me-to-a-long-random-string-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── LLM (Ollama) ──────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:14b
LLM_TIMEOUT=120

# ── Browser ────────────────────────────────────────────────────────────────────
# BROWSER_HEADLESS=true  → no visible browser (faster, recommended for prod/CI)
# BROWSER_HEADLESS=false → visible browser (useful for debugging only)
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=0

# ── Screenshot mode ────────────────────────────────────────────────────────────
# fail_only  — screenshot only when a step fails  (fastest, default)
# final      — one screenshot at the very end only
# all        — screenshot after every step (slowest; debugging only)
SCREENSHOT_MODE=fail_only

# ── Debug ──────────────────────────────────────────────────────────────────────
DEBUG=false
